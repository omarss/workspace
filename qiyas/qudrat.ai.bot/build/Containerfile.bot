FROM localhost/qudrat-bot-builder:dev AS build
ARG VERSION=dev
WORKDIR /work
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/bot ./cmd/bot

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/bot /bot
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/bot"]
