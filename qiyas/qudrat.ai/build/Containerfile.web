# Multi-stage build for the qudrat Next.js client.
# Stage 1: install deps + build the standalone bundle.
# Stage 2: tiny runtime — only the standalone server + static assets.
FROM docker.io/library/node:24-alpine AS deps
WORKDIR /web
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
COPY web/package.json web/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile=false

FROM docker.io/library/node:24-alpine AS build
WORKDIR /web
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
COPY --from=deps /web/node_modules ./node_modules
COPY web/ .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM docker.io/library/node:24-alpine AS runtime
WORKDIR /web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -g 65532 -S app && adduser -u 65532 -G app -S app
COPY --from=build /web/.next/standalone ./
COPY --from=build /web/.next/static ./.next/static
COPY --from=build /web/public ./public
USER 65532:65532
EXPOSE 3000
CMD ["node", "server.js"]
