# Multi-stage build for the qudrat one-shot importer. Run as a Kubernetes
# Job to seed the items table from JSON files mounted via a ConfigMap or
# baked into the image. Locally, `make import` runs the binary directly.
FROM localhost/qudrat-builder:dev AS build
ARG VERSION=dev
WORKDIR /work
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/importer ./cmd/importer

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/importer /importer
USER 65532:65532
ENTRYPOINT ["/importer"]
