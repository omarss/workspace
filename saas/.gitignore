# Build artifacts
/bin/
/dist/

# Node.js (TS SDK consumers install transitively; never commit lockfiles or modules here)
node_modules/
sdk/ts/*/node_modules/
sdk/ts/*/package-lock.json

# OpenAPI generated intermediates
/openapi/_generated/

# Coverage
coverage.out
coverage.html

# Editor / OS
.idea/
.vscode/
.DS_Store

# Secrets must never be committed (defense-in-depth; dev sentinels live in compose.yaml)
.env
.env.*
!.env.example
