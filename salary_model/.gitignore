# data/reports/ keeps tracked Markdown (the manual download targets and provenance)
# but ignores the actual downloaded PDFs/CSVs and the per-run manifest.
data/reports/**/*.pdf
data/reports/**/*.csv
data/reports/**/*.xlsx
data/reports/**/*.xls
data/reports/**/*.json
data/reports/**/*.xml
data/reports/**/manifest.jsonl
!data/seed/
*.parquet
*.joblib
*.pkl
*.lgb
*.cbm

# Reports: keep the index, ignore per-run binaries
reports/runs/**/*.bin
reports/runs/**/*.npz

