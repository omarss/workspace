# job-crawler — secret template (do NOT commit a real-password copy).
#
# Bootstrap the secret on the cluster directly from your local .env:
#
#   make deploy-secret
#
# Equivalent kubectl invocation:
#
#   set -a; source .env; set +a
#   kubectl create namespace job-crawler --dry-run=client -o yaml | kubectl apply -f -
#   kubectl create secret generic job-crawler-secrets -n job-crawler \
#     --from-literal=JCDB_DSN="postgresql://job_crawler:$JC_DB_PASSWORD@10.42.0.1:5432/job_crawler" \
#     --from-literal=SMTP_HOST="$SMTP_HOST" \
#     --from-literal=SMTP_PORT="$SMTP_PORT" \
#     --from-literal=SMTP_USERNAME="$SMTP_USERNAME" \
#     --from-literal=SMTP_PASSWORD="$SMTP_PASSWORD" \
#     --from-literal=ALERT_EMAIL_FROM="$ALERT_EMAIL_FROM" \
#     --from-literal=ALERT_EMAIL_TO="omar.s.shaaban@gmail.com" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Alert path is plain SMTP (no paid API). The values below assume Gmail's
# app-password SMTP — replace with any RFC-compliant relay you prefer.
#
# `10.42.0.1` is the k3s default host-gateway IP; pods reach the host
# Postgres on it. pg_hba.conf must allow 10.42.0.0/16 — handled by
# `make db-allow-k3s`.
apiVersion: v1
kind: Secret
metadata:
  name: job-crawler-secrets
  namespace: job-crawler
type: Opaque
stringData:
  JCDB_DSN:         "postgresql://job_crawler:REPLACE_ME@10.42.0.1:5432/job_crawler"
  SMTP_HOST:        "smtp.gmail.com"
  SMTP_PORT:        "587"
  SMTP_USERNAME:    "omar.s.shaaban@gmail.com"
  SMTP_PASSWORD:    "REPLACE_ME"           # Gmail app password (16 chars)
  SMTP_STARTTLS:    "true"
  SMTP_USE_SSL:     "false"
  ALERT_EMAIL_FROM: "job-crawler <alerts@jobs.omarss.net>"
  ALERT_EMAIL_TO:   "omar.s.shaaban@gmail.com"
